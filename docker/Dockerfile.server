# 多阶段构建 - 构建阶段
FROM node:20-alpine AS builder

# 安装 pnpm
RUN npm install -g pnpm@8.15.0

WORKDIR /app

# 复制依赖配置
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/types/package.json ./packages/types/
COPY packages/server/package.json ./packages/server/

# 安装依赖
RUN pnpm install --frozen-lockfile

# 复制源代码
COPY packages/types ./packages/types
COPY packages/server ./packages/server
COPY tsconfig.json ./

# 构建
RUN pnpm --filter @monitor/types build
RUN pnpm --filter @monitor/server build

# 生成数据库迁移文件
WORKDIR /app/packages/server
RUN pnpm db:generate

# 生产阶段
FROM node:20-alpine

# 安装 pnpm
RUN npm install -g pnpm@8.15.0

WORKDIR /app

# 复制依赖配置
COPY package.json pnpm-workspace.yaml ./
COPY packages/types/package.json ./packages/types/
COPY packages/server/package.json ./packages/server/

# 仅安装生产依赖
RUN pnpm install --frozen-lockfile --prod

# 复制构建产物
COPY --from=builder /app/packages/types/dist ./packages/types/dist
COPY --from=builder /app/packages/server/dist ./packages/server/dist
COPY --from=builder /app/packages/server/drizzle ./packages/server/drizzle

# 复制迁移脚本
COPY packages/server/src/db/migrate.ts ./packages/server/src/db/

WORKDIR /app/packages/server

# 暴露端口
EXPOSE 8080

# 启动命令：先执行迁移，再启动服务
CMD ["sh", "-c", "pnpm db:migrate && pnpm start"]
